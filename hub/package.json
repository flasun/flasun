{
  "name": "@flasun/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "marked": "^18.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "description": "Personal MCP hub: workspace (Notion replacement), projects, job search and finance modules over one SQLite store, with a local dashboard.",
  "bin": {
    "hub": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "dev": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
    "mcp": "node --disable-warning=ExperimentalWarning src/cli.ts mcp",
    "start": "node --disable-warning=ExperimentalWarning dist/cli.js serve"
  },
  "license": "UNLICENSED"
}
